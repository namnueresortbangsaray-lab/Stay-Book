@model LoginViewModel
@{
    Layout = "_AuthLayout";
}
<div class="login-shell">
  <aside class="brand-panel" aria-label="@T["app_name"]">
    <svg class="ledger" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="ledger-lines" width="40" height="32" patternUnits="userSpaceOnUse">
          <path d="M0 31.5H40" stroke="currentColor" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#ledger-lines)" />
      <path d="M72 0V2000" stroke="currentColor" stroke-width="1" />
      <path d="M78 0V2000" stroke="currentColor" stroke-width="1" />
    </svg>
    <div class="relative pl-14">
      <img src="/images/logo_white.webp" alt="" class="h-16 w-auto" width="160" height="64" data-logo>
      <p class="brand-wordmark mt-10">@T["app_name"]</p>
      <p class="mt-1 text-base">@T["ui.login.place"]</p>
    </div>
    <div class="relative max-w-sm pl-14">
      <p class="text-base">@T["ui.login.panel"]</p>
    </div>
  </aside>

  <main id="main" class="login-main" tabindex="-1">
    <div class="flex justify-end">
      <partial name="_ThemeSwitch" />
    </div>

    <div class="login-card">
      <partial name="_Logo" model='"h-14 w-auto lg:hidden"' />
      <h1 class="page-heading mt-6 lg:mt-0">@T["ui.login.title"]</h1>
      <p class="mt-1 text-sm text-ink-muted">@T["ui.login.subtitle"]</p>

      @if (Model.Error is not null)
      {
        <div role="alert" class="alert tone-danger mt-6">
          <icon name="error" />
          <span>@Model.Error</span>
        </div>
      }

      <form method="post" action="/login" asp-antiforgery="true" class="mt-6 space-y-4">
        <div>
          <label class="label" for="email">@T["ui.login.email"]</label>
          <input class="field" id="email" name="email" type="email" placeholder="admin@@staybook.local" autocomplete="username" required autofocus>
        </div>
        <div>
          <label class="label" for="password">@T["ui.login.password"]</label>
          <input class="field" id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-primary btn-lg w-full" type="submit">@T["login"]</button>
      </form>

      <p class="mt-10 text-xs text-ink-subtle">@T["ui.login.footer"]</p>
    </div>
  </main>
</div>
