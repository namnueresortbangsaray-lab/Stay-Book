@* Runs before first paint: applies the saved theme (or the OS scheme for "system"), density and sidebar state. *@
<script nonce="@Nonce.Value">(function(){var d=document.documentElement,g=function(k){try{return localStorage.getItem(k)}catch(e){return null}};var p=g('theme')||d.getAttribute('data-theme-pref')||'system';if(p!=='light'&&p!=='dark')p='system';var t=p==='system'?(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):p;d.setAttribute('data-theme',t);d.setAttribute('data-theme-pref',p);var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='dark'?'#121513':'#f6f3ee');if(g('density')==='compact')d.setAttribute('data-density','compact');var s=g('sidebar');if(s==='collapsed'||s==='expanded')d.setAttribute('data-sidebar',s);})();</script>
