@* Light / Dark / System as a segmented control (login and mobile menu); theme.js keeps aria-pressed in sync. *@
<div class="segmented" role="group" aria-label="@T["ui.theme.label"]">
  <button type="button" class="segmented-item" data-theme-option="light" aria-pressed="false"><icon name="sun" /><span>@T["ui.theme.light"]</span></button>
  <button type="button" class="segmented-item" data-theme-option="dark" aria-pressed="false"><icon name="moon" /><span>@T["ui.theme.dark"]</span></button>
  <button type="button" class="segmented-item" data-theme-option="system" aria-pressed="false"><icon name="system" /><span>@T["ui.theme.system"]</span></button>
</div>
