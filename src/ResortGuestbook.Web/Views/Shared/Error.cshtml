@model ErrorViewModel
@{
    var hint = T[$"ui.error.hint.{Model.Status}"];
    var signIn = Model.Status is 401 or 419 or 429;
}
<main id="main" class="error-shell" tabindex="-1">
  <a href="/" class="mb-12 inline-flex w-fit" aria-label="@T["ui.error.home"]">
    <partial name="_Logo" model='"h-12 w-auto"' />
  </a>
  <p class="error-code">@Model.Status</p>
  <h1 class="mt-2 text-xl font-semibold text-ink">@Model.Message</h1>
  <p class="mt-3 text-base text-ink-muted">@(hint.ResourceNotFound ? T["ui.error.hint.default"] : hint)</p>
  <p class="mt-1 text-sm text-ink-subtle">@T["ui.error.contact"]</p>
  <div class="mt-8 flex flex-wrap gap-2">
    <a href="/" class="btn btn-primary"><icon name="home" /><span>@T["ui.error.home"]</span></a>
    @if (signIn)
    {
      <a href="/login" class="btn btn-secondary">@T["login"]</a>
    }
  </div>
</main>
