@model ResortGuestbook.Web.Services.Actor
@{
    var name = string.IsNullOrEmpty(Model.Name) ? T["ui.user.fallback"].Value : Model.Name;
    var initial = System.Globalization.StringInfo.GetNextTextElement(name);
    var role = T[$"ui.role.{Model.Role}"];
}
<div id="app" data-role="@Model.Role" class="app-shell">
  <div id="splash" class="splash" aria-hidden="true"><div class="progress"></div></div>

  <aside id="sidebar" class="sidebar no-print">
    <div class="sidebar-inner">
      <div class="brand">
        <a href="/#today" class="flex min-h-11 min-w-11 items-center justify-center" aria-label="@T["ui.nav.today"]">
          <partial name="_Logo" model='"brand-logo"' />
          <img src="/images/logo_square.webp" alt="" class="brand-mark" width="36" height="36" data-logo>
        </a>
      </div>
      <p class="brand-place rail-hide">@T["ui.brand.place"]</p>
      <nav aria-label="@T["ui.nav.label"]">
        @{ ViewData["NavId"] = "side"; }
        <partial name="_NavItems" />
      </nav>

      <div class="sidebar-footer">
        <div class="user-card">
          <span class="avatar" aria-hidden="true">@initial</span>
          <div class="min-w-0 rail-hide">
            <p class="user-name">@name</p>
            <p class="user-role">@(role.ResourceNotFound ? Model.Role : role)</p>
          </div>
        </div>
        <form method="post" action="/logout" asp-antiforgery="true">
          <button class="nav-item" type="submit" data-tip="@T["ui.nav.signout"]"><icon name="signout" /><span class="nav-label">@T["ui.nav.signout"]</span></button>
        </form>
      </div>
    </div>
  </aside>

  <div class="app-main">
    <header class="topbar no-print">
      <button type="button" class="btn btn-ghost btn-icon -ml-2 hidden flex-none sm:inline-flex" data-action="toggle-sidebar" aria-controls="sidebar" aria-expanded="true" aria-label="@T["ui.nav.collapse"]" title="@T["ui.nav.collapse"]"><icon name="menu" /></button>
      <button type="button" class="btn btn-ghost btn-icon -ml-2 flex-none sm:hidden" data-action="mobile-more" aria-haspopup="dialog" aria-label="@T["ui.nav.open"]" title="@T["ui.nav.open"]"><icon name="menu" /></button>
      <nav aria-label="@T["ui.breadcrumb"]" class="min-w-0">
        <ol class="breadcrumb">
          <li class="hidden sm:block">@T["app_name"]</li>
          <li id="page-group" class="hidden lg:block">@T["ui.nav.group.daily"]</li>
          <li class="min-w-0"><h1 id="page-title" class="page-title">@T["ui.nav.today"]</h1></li>
        </ol>
      </nav>
      <div class="topbar-actions">
        <button type="button" class="btn btn-secondary hidden sm:inline-flex" data-action="command">
          <icon name="search" />
          <span>@T["ui.search"]</span>
          <kbd class="hidden lg:inline">Ctrl K</kbd>
        </button>
        <button type="button" class="btn btn-ghost btn-icon sm:hidden" data-action="command" aria-label="@T["ui.search"]"><icon name="search" /></button>
        <button type="button" class="btn btn-ghost btn-icon hidden sm:inline-flex" data-action="theme-menu" aria-haspopup="menu" aria-expanded="false" aria-label="@T["ui.theme.label"]" title="@T["ui.theme.label"]"><icon name="sun" class="theme-icon-light" /><icon name="moon" class="theme-icon-dark" /></button>
        <button type="button" class="btn btn-ghost btn-icon hidden sm:inline-flex" data-action="toggle-density" aria-pressed="false" aria-label="@T["ui.density.compact"]" title="@T["ui.density.compact"]"><icon name="density" /></button>
        <button type="button" class="btn btn-primary" data-action="new-booking" data-booking-control>
          <icon name="plus" />
          <span class="hidden sm:inline">@T["ui.booking.new"]</span>
          <span class="sr-only sm:hidden">@T["ui.booking.new"]</span>
        </button>
      </div>
    </header>

    <main id="main" class="content" tabindex="-1" data-state="loading">
      <div id="loading" aria-busy="true">
        <p class="sr-only">@T["ui.loading"]</p>
        <div class="skeleton h-5 w-48"></div>
        <div class="skeleton mt-3 h-8 w-72 max-w-full"></div>
        <div class="kpi-strip kpi-strip-5 mt-6">
          @for (var i = 0; i < 5; i++)
          {
            <div class="kpi"><div class="skeleton h-3.5 w-24"></div><div class="skeleton mt-3 h-6 w-12"></div></div>
          }
        </div>
        <div class="skeleton mt-6 h-64 w-full"></div>
      </div>

      <div id="toast-region" class="toast-region" role="status" aria-live="polite"></div>

      <section id="page-today" data-page-panel aria-labelledby="page-title">
        <div id="today-desk"></div>
      </section>

      <section id="page-room-map" data-page-panel hidden aria-labelledby="page-title">
        <div id="room-summary"></div>
        <div id="room-map"></div>
      </section>

      <section id="page-bookings" data-page-panel hidden aria-labelledby="page-title">
        <div class="table-toolbar">
          <div class="segmented" role="group" aria-label="@T["ui.bookings.view"]">
            <button type="button" class="segmented-item" aria-pressed="true" data-view="list"><icon name="bookings" /><span>@T["ui.bookings.list"]</span></button>
            <button type="button" class="segmented-item" aria-pressed="false" data-view="calendar"><icon name="calendarDays" /><span>@T["ui.bookings.calendar"]</span></button>
          </div>
          <div class="search-field order-last w-full sm:order-none sm:w-auto sm:min-w-[14rem] sm:flex-1">
            <icon name="search" />
            <input id="stay-search" class="field" type="search" placeholder="@T["ui.bookings.search"]" aria-label="@T["ui.bookings.search"]" autocomplete="off">
          </div>
          <button type="button" class="btn btn-secondary max-sm:!hidden" data-columns="bookings" aria-haspopup="menu" aria-expanded="false"><icon name="columns" /><span>@T["ui.table.columns"]</span></button>
        </div>
        <div id="stay-status-chips" class="chip-row mb-3" role="group" aria-label="@T["ui.bookings.status_filter"]"></div>
        <select id="stay-status" hidden aria-hidden="true" tabindex="-1">
          <option value=""></option>
          <option value="0"></option>
          <option value="1"></option>
          <option value="2"></option>
        </select>
        <div id="booking-list"></div>
        <div id="booking-calendar" hidden></div>
      </section>

      <section id="page-dashboard" data-page-panel hidden aria-labelledby="page-title">
        <div class="print-only mb-6">
          <p class="font-serif text-xl font-semibold">@T["app_name"] @T["location"] · @T["ui.nav.reports"]</p>
          <p id="report-print-range" class="text-sm"></p>
        </div>
        <div class="card no-print mb-6 flex flex-wrap items-end gap-3 p-4">
          <div>
            <p class="label">@T["ui.reports.period"]</p>
            <div class="segmented" role="group" aria-label="@T["ui.reports.period"]">
              <button type="button" class="segmented-item" aria-pressed="false" data-range="today">@T["ui.reports.today"]</button>
              <button type="button" class="segmented-item" aria-pressed="false" data-range="7days">@T["ui.reports.7days"]</button>
              <button type="button" class="segmented-item" aria-pressed="true" data-range="month">@T["ui.reports.month"]</button>
            </div>
          </div>
          <div>
            <label class="label" for="range-start">@T["ui.reports.from"]</label>
            <input id="range-start" class="field w-44" type="date">
          </div>
          <div>
            <label class="label" for="range-end">@T["ui.reports.to"]</label>
            <input id="range-end" class="field w-44" type="date">
          </div>
          <button id="apply-range" type="button" class="btn btn-secondary">@T["ui.reports.apply"]</button>
          <div class="flex gap-2 sm:ml-auto">
            <a class="btn btn-secondary" href="/api/v1/reports/bookings.csv"><icon name="download" /><span>@T["ui.reports.csv"]</span></a>
            <button type="button" class="btn btn-secondary" data-action="print"><icon name="print" /><span>@T["ui.reports.print"]</span></button>
          </div>
        </div>
        <div id="analytics"></div>
      </section>

      <section id="page-rooms" data-page-panel hidden aria-labelledby="page-title">
        <div class="tabs mb-6" role="tablist" aria-label="@T["ui.rooms.tabs"]">
          <button type="button" class="tab" role="tab" id="rooms-tab-rooms" aria-controls="rooms-panel-rooms" aria-selected="true">@T["ui.rooms.tab.rooms"]</button>
          <button type="button" class="tab" role="tab" id="rooms-tab-zones" aria-controls="rooms-panel-zones" aria-selected="false" tabindex="-1">@T["ui.rooms.tab.zones"]</button>
          <button type="button" class="tab" role="tab" id="rooms-tab-types" aria-controls="rooms-panel-types" aria-selected="false" tabindex="-1">@T["ui.rooms.tab.types"]</button>
        </div>
        <div id="rooms-panel-rooms" role="tabpanel" aria-labelledby="rooms-tab-rooms">
          <div class="section-head">
            <div>
              <h2 class="text-lg font-semibold">@T["ui.rooms.title"]</h2>
              <p class="text-sm text-ink-muted">@T["ui.rooms.subtitle"]</p>
            </div>
            <button type="button" class="btn btn-primary" data-action="new-room"><icon name="plus" /><span>@T["ui.rooms.new"]</span></button>
          </div>
          <div id="rooms-list"></div>
        </div>
        <div id="rooms-panel-zones" role="tabpanel" aria-labelledby="rooms-tab-zones" hidden>
          <div class="section-head">
            <div>
              <h2 class="text-lg font-semibold">@T["ui.zones.title"]</h2>
              <p class="text-sm text-ink-muted">@T["ui.zones.subtitle"]</p>
            </div>
            <button type="button" class="btn btn-primary" data-action="new-zone"><icon name="plus" /><span>@T["ui.zones.new"]</span></button>
          </div>
          <div id="zone-list"></div>
        </div>
        <div id="rooms-panel-types" role="tabpanel" aria-labelledby="rooms-tab-types" hidden>
          <div class="section-head">
            <div>
              <h2 class="text-lg font-semibold">@T["ui.types.title"]</h2>
              <p class="text-sm text-ink-muted">@T["ui.types.subtitle"]</p>
            </div>
            <button type="button" class="btn btn-primary" data-action="new-type"><icon name="plus" /><span>@T["ui.types.new"]</span></button>
          </div>
          <div id="type-list"></div>
        </div>
      </section>

      <section id="page-guests" data-page-panel hidden aria-labelledby="page-title">
        <div class="table-toolbar">
          <div class="search-field min-w-[14rem] flex-1">
            <icon name="search" />
            <input id="guest-search" class="field" type="search" placeholder="@T["ui.guests.search"]" aria-label="@T["ui.guests.search"]" autocomplete="off">
          </div>
          <label class="sm:hidden">
            <span class="sr-only">@T["ui.guests.sort"]</span>
            <select id="guest-sort" class="field form-select w-auto">
              <option value="latest">@T["ui.guests.sort.latest"]</option>
              <option value="count">@T["ui.guests.sort.count"]</option>
              <option value="value">@T["ui.guests.sort.value"]</option>
              <option value="name">@T["ui.guests.sort.name"]</option>
            </select>
          </label>
          <label class="chip cursor-pointer gap-2">
            <input id="regular-only" type="checkbox" class="switch">
            <span>@T["ui.guests.regular_only"]</span>
          </label>
        </div>
        <div id="guest-list"></div>
      </section>
    </main>
  </div>

  <nav class="tabbar no-print" aria-label="@T["ui.nav.mobile"]">
    <button type="button" class="tab-item" data-page="today"><icon name="today" /><span>@T["ui.nav.today"]</span></button>
    <button type="button" class="tab-item" data-page="room-map"><icon name="roomMap" /><span>@T["ui.nav.room_map_short"]</span></button>
    <button type="button" class="tab-item" data-page="bookings"><icon name="bookings" /><span>@T["ui.nav.bookings_short"]</span></button>
    <button type="button" class="tab-item" data-page="guests"><icon name="guests" /><span>@T["ui.nav.guests"]</span></button>
    <button type="button" class="tab-item" data-action="mobile-more" aria-haspopup="dialog"><icon name="menu" /><span>@T["ui.nav.more"]</span></button>
  </nav>
</div>

<!-- Command palette -->
<dialog id="command-dialog" class="modal [--dialog-w:40rem]" aria-label="@T["ui.command.label"]">
  <div class="flex items-center gap-3 border-b border-line px-4">
    <icon name="search" class="h-5 w-5 text-ink-subtle" />
    <input id="command-search" class="h-14 min-w-0 flex-1 border-0 bg-transparent text-base text-ink placeholder:text-ink-subtle focus:outline-none focus:ring-0" placeholder="@T["ui.command.placeholder"]" aria-label="@T["ui.command.placeholder"]" autocomplete="off">
    <button type="button" class="btn btn-ghost btn-sm" data-close><kbd>Esc</kbd></button>
  </div>
  <div id="command-results" class="max-h-[60dvh] overflow-y-auto p-2"></div>
</dialog>

<!-- Booking drawer -->
<dialog id="booking-dialog" class="drawer [--dialog-w:42rem]" aria-labelledby="booking-dialog-title">
  <form id="booking-form" novalidate data-guard>
    <div class="dialog-header">
      <div>
        <h2 id="booking-dialog-title" class="dialog-title" data-dialog-title>@T["ui.booking.new"]</h2>
        <p class="dialog-sub">@T["ui.booking.subtitle"]</p>
      </div>
      <button type="button" class="btn btn-ghost btn-icon" data-close aria-label="@T["ui.close"]"><icon name="close" /></button>
    </div>
    <input type="hidden" name="id">
    <div class="dialog-body">
      <section class="form-section">
        <h3 class="form-section-title">@T["ui.booking.section.guest"]</h3>
        <div class="form-grid">
          <div>
            <label class="label" for="booking-phone">@T["ui.booking.phone"]<span class="req" aria-hidden="true">*</span></label>
            <input id="booking-phone" class="field" name="phone" required inputmode="tel" autocomplete="tel" placeholder="08x-xxx-xxxx" aria-describedby="booking-phone-hint">
            <p id="booking-phone-hint" class="hint">@T["ui.booking.phone_hint"]</p>
          </div>
          <div>
            <label class="label" for="booking-name">@T["ui.booking.name"]<span class="req" aria-hidden="true">*</span></label>
            <input id="booking-name" class="field" name="guest_name" required minlength="2" autocomplete="name">
          </div>
        </div>
      </section>
      <section class="form-section">
        <h3 class="form-section-title">@T["ui.booking.section.stay"]</h3>
        <div class="form-grid">
          <div>
            <label class="label" for="booking-in">@T["ui.booking.check_in"]<span class="req" aria-hidden="true">*</span></label>
            <input id="booking-in" class="field" type="date" name="check_in_date" required aria-describedby="booking-in-hint">
            <p id="booking-in-hint" class="hint">@T["ui.booking.check_in_hint"]</p>
          </div>
          <div>
            <label class="label" for="booking-out">@T["ui.booking.check_out"]<span class="req" aria-hidden="true">*</span></label>
            <input id="booking-out" class="field" type="date" name="check_out_date" required aria-describedby="booking-out-hint">
            <p id="booking-out-hint" class="hint">@T["ui.booking.check_out_hint"]</p>
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="booking-room">@T["ui.booking.room"]<span class="req" aria-hidden="true">*</span></label>
            <select id="booking-room" class="field form-select" name="room_id" required></select>
          </div>
          <div>
            <label class="label" for="booking-guests">@T["ui.booking.guests"]<span class="req" aria-hidden="true">*</span></label>
            <input id="booking-guests" class="field" type="number" name="guests" min="1" value="2" required inputmode="numeric">
          </div>
          <label class="check-row self-end">
            <input type="checkbox" name="extra_bed" class="form-checkbox check">
            <span>@T["ui.booking.extra_bed"]</span>
          </label>
          <div>
            <label class="label" for="booking-pet-type">@T["ui.booking.pet_type"]</label>
            <select id="booking-pet-type" class="field form-select" name="pet_type">
              <option value="">@T["ui.booking.pet_none"]</option>
              <option value="สุนัข">@T["ui.booking.pet_dog"]</option>
              <option value="แมว">@T["ui.booking.pet_cat"]</option>
              <option value="อื่น ๆ">@T["ui.booking.pet_other"]</option>
            </select>
          </div>
          <div>
            <label class="label" for="booking-pet-count">@T["ui.booking.pet_count"]</label>
            <input id="booking-pet-count" class="field" type="number" name="pet_count" min="0" value="0" inputmode="numeric">
          </div>
        </div>
      </section>
      <section class="form-section">
        <h3 class="form-section-title">@T["ui.booking.section.payment"]</h3>
        <div class="form-grid">
          <div>
            <label class="label" for="booking-deposit">@T["ui.booking.deposit"]</label>
            <input id="booking-deposit" class="field num" type="number" name="deposit_amount" min="0" step="0.01" value="0" inputmode="decimal">
          </div>
          <div>
            <label class="label" for="booking-discount">@T["ui.booking.discount"]</label>
            <input id="booking-discount" class="field num" type="number" name="discount_amount" min="0" step="0.01" value="0" inputmode="decimal">
          </div>
          <label class="check-row">
            <input type="checkbox" name="deposit_paid" class="form-checkbox check">
            <span>@T["ui.booking.deposit_paid"]</span>
          </label>
          <label class="check-row">
            <input type="checkbox" name="id_verified" class="form-checkbox check">
            <span>@T["ui.booking.id_verified"]</span>
          </label>
          <label class="check-row sm:col-span-2">
            <input type="checkbox" name="check_in_now" class="form-checkbox check">
            <span>@T["ui.booking.check_in_now"]</span>
          </label>
        </div>
      </section>
      <section class="form-section">
        <label class="label" for="booking-note">@T["ui.booking.note"]</label>
        <textarea id="booking-note" class="field" name="note" rows="3" placeholder="@T["ui.booking.note_placeholder"]"></textarea>
      </section>
      <div id="price-preview" class="mt-6 rounded-lg border border-line bg-surface p-4" aria-live="polite"></div>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn btn-ghost" data-close>@T["ui.cancel"]</button>
      <button class="btn btn-primary" type="submit" data-submit-label>@T["ui.booking.new"]</button>
    </div>
  </form>
</dialog>

<!-- Room drawer -->
<dialog id="room-dialog" class="drawer [--dialog-w:36rem]" aria-labelledby="room-dialog-title">
  <form id="room-form" novalidate data-guard>
    <div class="dialog-header">
      <div>
        <h2 id="room-dialog-title" class="dialog-title" data-dialog-title>@T["ui.rooms.new"]</h2>
        <p class="dialog-sub">@T["ui.room.subtitle"]</p>
      </div>
      <button type="button" class="btn btn-ghost btn-icon" data-close aria-label="@T["ui.close"]"><icon name="close" /></button>
    </div>
    <input type="hidden" name="id">
    <div class="dialog-body">
      <section class="form-section">
        <h3 class="form-section-title">@T["ui.room.section.identity"]</h3>
        <div class="form-grid">
          <div>
            <label class="label" for="room-name">@T["ui.room.name"]<span class="req" aria-hidden="true">*</span></label>
            <input id="room-name" class="field" name="name" required placeholder="@T["ui.room.name_placeholder"]">
          </div>
          <div>
            <label class="label" for="room-zone">@T["ui.room.zone"]<span class="req" aria-hidden="true">*</span></label>
            <select id="room-zone" class="field form-select" name="zone" required></select>
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="room-type">@T["ui.room.type"]<span class="req" aria-hidden="true">*</span></label>
            <select id="room-type" class="field form-select" name="type" required aria-describedby="room-type-hint"></select>
            <p id="room-type-hint" class="hint">@T["ui.room.type_hint"]</p>
          </div>
          <div class="sm:col-span-2">
            <button type="button" class="link inline-flex items-center gap-1.5 text-sm" data-action="manage-categories"><icon name="settings" /><span>@T["ui.room.manage_categories"]</span></button>
          </div>
        </div>
      </section>
      <section class="form-section">
        <h3 class="form-section-title">@T["ui.room.section.pricing"]</h3>
        <div class="form-grid">
          <div>
            <label class="label" for="room-price">@T["ui.room.price"]<span class="req" aria-hidden="true">*</span></label>
            <input id="room-price" class="field num" type="number" name="price" min="1" value="500" required inputmode="decimal">
          </div>
          <div>
            <label class="label" for="room-extra-fee">@T["ui.room.extra_fee"]</label>
            <input id="room-extra-fee" class="field num" type="number" name="extra_guest_fee" min="0" value="100" inputmode="decimal">
          </div>
          <div>
            <label class="label" for="room-base">@T["ui.room.base_guests"]</label>
            <input id="room-base" class="field num" type="number" name="base_guests" min="1" value="2" inputmode="numeric">
          </div>
          <div>
            <label class="label" for="room-max">@T["ui.room.max_guests"]</label>
            <input id="room-max" class="field num" type="number" name="max_guests" min="1" value="3" inputmode="numeric">
          </div>
        </div>
      </section>
      <section class="form-section">
        <h3 class="form-section-title">@T["ui.room.section.display"]</h3>
        <div class="form-grid">
          <div>
            <label class="label" for="room-sort">@T["ui.room.sort_order"]</label>
            <input id="room-sort" class="field num" type="number" name="sort_order" min="0" value="0" inputmode="numeric" aria-describedby="room-sort-hint">
            <p id="room-sort-hint" class="hint">@T["ui.room.sort_hint"]</p>
          </div>
          <label class="check-row self-start sm:mt-7">
            <input type="checkbox" name="is_pet_friendly" class="form-checkbox check">
            <span>@T["ui.room.pet_friendly"]</span>
          </label>
        </div>
      </section>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn btn-ghost" data-close>@T["ui.cancel"]</button>
      <button class="btn btn-primary" type="submit" data-submit-label>@T["ui.rooms.new"]</button>
    </div>
  </form>
</dialog>

<dialog id="zone-dialog" class="modal [--dialog-w:28rem]" aria-labelledby="zone-dialog-title">
  <form id="zone-form" novalidate data-guard>
    <div class="dialog-header">
      <div>
        <h2 id="zone-dialog-title" class="dialog-title" data-dialog-title>@T["ui.zones.new"]</h2>
        <p class="dialog-sub">@T["ui.zones.dialog_sub"]</p>
      </div>
      <button type="button" class="btn btn-ghost btn-icon" data-close aria-label="@T["ui.close"]"><icon name="close" /></button>
    </div>
    <input type="hidden" name="id">
    <div class="dialog-body space-y-4">
      <div>
        <label class="label" for="zone-name">@T["ui.zones.name"]<span class="req" aria-hidden="true">*</span></label>
        <input id="zone-name" class="field" name="name" required placeholder="@T["ui.zones.name_placeholder"]">
      </div>
      <div>
        <label class="label" for="zone-sort">@T["ui.category.order"]</label>
        <input id="zone-sort" class="field num" type="number" name="sort_order" min="0" value="0" inputmode="numeric" aria-describedby="zone-sort-hint">
        <p id="zone-sort-hint" class="hint">@T["ui.category.order_hint"]</p>
      </div>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn btn-ghost" data-close>@T["ui.cancel"]</button>
      <button class="btn btn-primary" type="submit" data-submit-label>@T["ui.zones.new"]</button>
    </div>
  </form>
</dialog>

<dialog id="type-dialog" class="modal [--dialog-w:34rem]" aria-labelledby="type-dialog-title">
  <form id="type-form" novalidate data-guard>
    <div class="dialog-header">
      <div>
        <h2 id="type-dialog-title" class="dialog-title" data-dialog-title>@T["ui.types.new"]</h2>
        <p class="dialog-sub">@T["ui.types.dialog_sub"]</p>
      </div>
      <button type="button" class="btn btn-ghost btn-icon" data-close aria-label="@T["ui.close"]"><icon name="close" /></button>
    </div>
    <input type="hidden" name="id">
    <div class="dialog-body">
      <div class="form-grid">
        <div class="sm:col-span-2">
          <label class="label" for="type-name">@T["ui.types.name"]<span class="req" aria-hidden="true">*</span></label>
          <input id="type-name" class="field" name="name" required placeholder="@T["ui.types.name_placeholder"]">
        </div>
          <div>
            <label class="label" for="type-price">@T["ui.room.price"]<span class="req" aria-hidden="true">*</span></label>
            <input id="type-price" class="field num" type="number" name="price" min="1" value="500" required inputmode="decimal">
          </div>
          <div>
            <label class="label" for="type-extra-fee">@T["ui.room.extra_fee"]</label>
            <input id="type-extra-fee" class="field num" type="number" name="extra_guest_fee" min="0" value="100" inputmode="decimal">
          </div>
          <div>
            <label class="label" for="type-base">@T["ui.room.base_guests"]</label>
            <input id="type-base" class="field num" type="number" name="base_guests" min="1" value="2" inputmode="numeric">
          </div>
          <div>
            <label class="label" for="type-max">@T["ui.room.max_guests"]</label>
            <input id="type-max" class="field num" type="number" name="max_guests" min="1" value="3" inputmode="numeric">
          </div>
        <div>
          <label class="label" for="type-sort">@T["ui.category.order"]</label>
          <input id="type-sort" class="field num" type="number" name="sort_order" min="0" value="0" inputmode="numeric" aria-describedby="type-sort-hint">
          <p id="type-sort-hint" class="hint">@T["ui.category.order_hint"]</p>
        </div>
        <label class="check-row self-start sm:mt-7">
          <input type="checkbox" name="is_pet_friendly" class="form-checkbox check">
          <span>@T["ui.room.pet_friendly"]</span>
        </label>
      </div>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn btn-ghost" data-close>@T["ui.cancel"]</button>
      <button class="btn btn-primary" type="submit" data-submit-label>@T["ui.types.new"]</button>
    </div>
  </form>
</dialog>

<!-- Stay action drawer: checkout inspection, extension, upload -->
<dialog id="action-dialog" class="drawer [--dialog-w:34rem]" aria-labelledby="action-title">
  <form id="action-form" novalidate data-guard>
    <div class="dialog-header">
      <div>
        <h2 id="action-title" class="dialog-title">@T["ui.action.title"]</h2>
        <p id="action-subtitle" class="dialog-sub"></p>
      </div>
      <button type="button" class="btn btn-ghost btn-icon" data-close aria-label="@T["ui.close"]"><icon name="close" /></button>
    </div>
    <input type="hidden" name="stay_id">
    <input type="hidden" name="action">
    <div id="action-fields" class="dialog-body space-y-4"></div>
    <div class="dialog-actions">
      <button type="button" class="btn btn-ghost" data-close>@T["ui.cancel"]</button>
      <button class="btn btn-primary" type="submit" data-submit-label>@T["ui.action.submit"]</button>
    </div>
  </form>
</dialog>

<!-- Guest profile drawer -->
<dialog id="guest-dialog" class="drawer [--dialog-w:44rem]" aria-labelledby="guest-dialog-title">
  <form id="guest-form" novalidate data-guard>
    <div class="dialog-header">
      <div id="guest-head" class="profile-head min-w-0"></div>
      <button type="button" class="btn btn-ghost btn-icon" data-close aria-label="@T["ui.close"]"><icon name="close" /></button>
    </div>
    <input type="hidden" name="id">
    <div class="px-5 sm:px-6">
      <div class="tabs" role="tablist" aria-label="@T["ui.guest.tabs"]">
        <button type="button" class="tab" role="tab" id="guest-tab-overview" aria-controls="guest-panel-overview" aria-selected="true">@T["ui.guest.tab.overview"]</button>
        <button type="button" class="tab" role="tab" id="guest-tab-stays" aria-controls="guest-panel-stays" aria-selected="false" tabindex="-1">@T["ui.guest.tab.stays"]</button>
        <button type="button" class="tab" role="tab" id="guest-tab-notes" aria-controls="guest-panel-notes" aria-selected="false" tabindex="-1">@T["ui.guest.tab.notes"]</button>
        <button type="button" class="tab" role="tab" id="guest-tab-files" aria-controls="guest-panel-files" aria-selected="false" tabindex="-1">@T["ui.guest.tab.files"]</button>
      </div>
    </div>
    <div class="dialog-body">
      <div id="guest-panel-overview" role="tabpanel" aria-labelledby="guest-tab-overview">
        <div id="guest-stats"></div>
        <div class="form-grid mt-6">
          <div>
            <label class="label" for="guest-name">@T["ui.guest.name"]<span class="req" aria-hidden="true">*</span></label>
            <input id="guest-name" class="field" name="name" required>
          </div>
          <div>
            <label class="label" for="guest-phone">@T["ui.guest.phone"]<span class="req" aria-hidden="true">*</span></label>
            <input id="guest-phone" class="field" name="phone" required inputmode="tel">
          </div>
          <div>
            <label class="label" for="guest-type">@T["ui.guest.type"]</label>
            <input id="guest-type" class="field" name="customer_type" placeholder="@T["ui.guest.type_placeholder"]">
          </div>
          <label class="check-row self-end">
            <input type="checkbox" name="is_regular" class="form-checkbox check">
            <span>@T["ui.guest.regular"]</span>
          </label>
          <div class="sm:col-span-2">
            <label class="label" for="guest-note">@T["ui.guest.note"]</label>
            <textarea id="guest-note" class="field" name="customer_note" rows="2" placeholder="@T["ui.guest.note_placeholder"]"></textarea>
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="guest-prefs">@T["ui.guest.preferences"]</label>
            <textarea id="guest-prefs" class="field" name="preferences" rows="2" placeholder="@T["ui.guest.preferences_placeholder"]"></textarea>
          </div>
        </div>
      </div>
      <div id="guest-panel-stays" role="tabpanel" aria-labelledby="guest-tab-stays" hidden>
        <div id="guest-history"></div>
      </div>
      <div id="guest-panel-notes" role="tabpanel" aria-labelledby="guest-tab-notes" hidden>
        <div id="guest-notes"></div>
      </div>
      <div id="guest-panel-files" role="tabpanel" aria-labelledby="guest-tab-files" hidden>
        <div id="guest-files"></div>
      </div>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn btn-ghost" data-close>@T["ui.cancel"]</button>
      <button class="btn btn-primary" type="submit">@T["ui.save"]</button>
    </div>
  </form>
</dialog>

<!-- Attachment viewer -->
<dialog id="file-dialog" class="modal [--dialog-w:56rem]" aria-labelledby="file-dialog-title">
  <div class="dialog-header">
    <h2 id="file-dialog-title" class="dialog-title truncate"></h2>
    <div class="flex items-center gap-1">
      <button type="button" class="btn btn-ghost btn-icon" data-file-step="-1" aria-label="@T["ui.files.previous"]"><icon name="chevronLeft" /></button>
      <button type="button" class="btn btn-ghost btn-icon" data-file-step="1" aria-label="@T["ui.files.next"]"><icon name="chevronRight" /></button>
      <a id="file-dialog-download" class="btn btn-ghost btn-icon" href="#" aria-label="@T["ui.files.download"]"><icon name="download" /></a>
      <button type="button" class="btn btn-ghost btn-icon" data-close aria-label="@T["ui.close"]"><icon name="close" /></button>
    </div>
  </div>
  <div id="file-dialog-body" class="dialog-body bg-sunken"></div>
</dialog>

<!-- Mobile navigation drawer -->
<dialog id="mobile-more-dialog" class="drawer drawer-left [--dialog-w:20rem]" aria-label="@T["ui.nav.label"]">
  <div class="drawer-inner">
    <div class="dialog-header items-center">
      <partial name="_Logo" model='"h-9 w-auto"' />
      <button type="button" class="btn btn-ghost btn-icon" data-close aria-label="@T["ui.close"]"><icon name="close" /></button>
    </div>
    <nav class="dialog-body px-3" aria-label="@T["ui.nav.label"]">
      @{ ViewData["NavId"] = "drawer"; }
      <partial name="_NavItems" />
      <p class="nav-heading">@T["ui.theme.label"]</p>
      <div class="px-1"><partial name="_ThemeSwitch" /></div>
    </nav>
    <div class="dialog-actions justify-between">
      <div class="user-card min-w-0">
        <span class="avatar" aria-hidden="true">@initial</span>
        <div class="min-w-0">
          <p class="user-name">@name</p>
          <p class="user-role">@(role.ResourceNotFound ? Model.Role : role)</p>
        </div>
      </div>
      <form method="post" action="/logout" asp-antiforgery="true">
        <button class="btn btn-secondary" type="submit"><icon name="signout" /><span>@T["ui.nav.signout"]</span></button>
      </form>
    </div>
  </div>
</dialog>

<!-- Confirmation -->
<dialog id="confirm-dialog" class="modal [--dialog-w:28rem]" role="alertdialog" aria-labelledby="confirm-title" aria-describedby="confirm-message">
  <div class="p-5 sm:p-6">
    <div class="flex items-start gap-3">
      <span id="confirm-icon" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sunken text-ink-muted"><icon name="info" class="h-5 w-5" /></span>
      <div>
        <h2 id="confirm-title" class="text-base font-semibold">@T["ui.action.submit"]</h2>
        <p id="confirm-message" class="mt-1 text-sm text-ink-muted"></p>
      </div>
    </div>
    <div class="mt-6 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost" data-confirm-cancel>@T["ui.cancel"]</button>
      <button type="button" class="btn btn-primary" data-confirm-accept>@T["ui.confirm"]</button>
    </div>
  </div>
</dialog>
