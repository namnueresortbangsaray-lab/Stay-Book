{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Timezone": "Asia/Bangkok",
    "TrustForwardedHeaders": false
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": true,
    "Seed": false
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=storage/database/staybook.db"
  },
  "Storage": {
    "Provider": "Local",
    "UploadsPath": "storage/uploads",
    "BackupsPath": "storage/backups",
    "LogsPath": "storage/logs",
    "KeysPath": "storage/keys"
  }
}
