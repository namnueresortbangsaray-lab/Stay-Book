APP_NAME="Stay Book"
APP_ENV=local
APP_DEBUG=false
APP_KEY=change-this-to-a-long-random-string
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Bangkok
APP_PORT=8080
DB_DRIVER=sqlite
SQLITE_PATH=/var/www/html/storage/database/stay_book.sqlite
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
PGSQL_SSLMODE=prefer
PGSQL_EMULATE_PREPARES=false
DB_SEED=true
DEMO_ADMIN_EMAIL=admin@staybook.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
SESSION_LIFETIME=120
UPLOAD_MAX_BYTES=5242880
BACKUP_KEEP=7
