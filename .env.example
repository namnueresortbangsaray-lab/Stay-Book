# Copy to .env (never commit .env). Names with __ map to ASP.NET Core configuration sections.

# Host port for http://localhost:8080
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
# Kestrel listens on 8080 (the image default); set ASPNETCORE_URLS only to change that.
# ASPNETCORE_URLS=http://+:8080
App__Timezone=Asia/Bangkok

# Database: Sqlite (default) or Postgres (Supabase). See docs/SUPABASE.md before switching.
Database__Provider=Sqlite
Database__AutoMigrate=true
Database__Seed=true
ConnectionStrings__Sqlite=Data Source=/app/storage/database/staybook.db

# Supabase / PostgreSQL (used when Database__Provider=Postgres). Port 6543 = transaction pooler.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
PGSQL_SSLMODE=Require
SUPABASE_DB_TRANSACTION_POOLER=false

# Demo administrator created by the seeder when missing. Change before the first production start.
DEMO_ADMIN_EMAIL=admin@staybook.local
DEMO_ADMIN_PASSWORD=ChangeMe123!

# Files and sessions
Storage__Provider=Local
UPLOAD_MAX_BYTES=5242880
SESSION_LIFETIME=120
BACKUP_KEEP=7
