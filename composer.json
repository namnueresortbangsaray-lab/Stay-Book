{
  "name": "namnuea/stay-book",
  "description": "Resort guest operations and booking logbook",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-json": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.68",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "config": {"sort-packages": true, "allow-plugins": false},
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "format:check": "php-cs-fixer fix --dry-run --diff"
  }
}
